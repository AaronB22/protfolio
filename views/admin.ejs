<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="./imgs/icon.png">
  <script src="//code.jquery.com/jquery-3.7.1.js"> </script>
  <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>
  <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
  <title>Admin</title>
</head>

<body>
  <%- include('partials/navbar') %>
  <table id="order-table" class="display">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Job</th>
        <th>Company</th>
        <th>LinkedIn</th>
        <th>How we meet</th>
        <th>Message</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% contacts.forEach(contact => { %>
      <tr>
        <td><%= contact.fname %> <%= contact.lname %></td>
        <td><%= contact.email %></td>
        <td><%= contact.job %></td>
        <td><%= contact.comp %></td>
        <td>
          <% if(contact.link) { %>
          <a href="<%= contact.link %>" target="_blank">Link</a>
          <% } else { %>
          -
          <% } %>
        </td>
        <td><%= contact.meet %></td>

        <td>
          <% if(contact.msg) { %>
          <%= contact.msg %>
          <% } else { %>
          -
          <% } %>
        </td>

        <td><%= contact.created_at %></td>

      </tr>
      <% }) %>
    </tbody>
</body>
<script defer>
  let table = new DataTable('#order-table')
</script>

</html>